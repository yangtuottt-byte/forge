"""配置说明书"""

# 应用
APP_NAME=Forge           # 应用名
APP_ENV=dev              # dev / prod

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forge
DB_USER=forge
DB_PASSWORD=forge

# ===== 认证 =====
JWT_SECRET=dev-secret-change-me-at-first-run-min-32-bytes-long-xyz123
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440        # 令牌有效期(分钟)

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== CORS =====
# 前端来源,逗号分隔(生产经 nginx 同源反代,通常留空即可)
CORS_ORIGINS=http://localhost:5173

# ===== LLM =====
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v1
LLM_MODEL=spark-x2.6
