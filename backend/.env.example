"""配置说明书"""

# 应用
APP_NAME=Forge           # 应用名
APP_ENV=dev              # dev / prod

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forge
DB_USER=forge
DB_PASSWORD=forge

# ===== 认证 =====
JWT_SECRET=dev-secret-change-me-at-first-run
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440        # 令牌有效期(分钟)

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
