# ===== 密钥文件,绝不提交 =====
.env
.env.*
# 模板 .env.example 是唯一例外(配置说明书,要入库)
!.env.example

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
*.egg-info/

# ===== IDE =====
.vscode/
.idea/
*.swp

# ===== 数据/日志/缓存(生成的不提交) =====
data/cache/
logs/
*.log

# ===== Agent 代码执行工作区(动态生成,不提交) =====
workspace/
*.tmp

# ===== Node / 前端(前端目录另有 .gitignore,这里兜底根级散落物) =====
node_modules/
dist/
*.tsbuildinfo

# ===== Docker =====
*.pid
